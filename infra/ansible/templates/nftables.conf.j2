#!/usr/sbin/nft -f
# Managed by infra/ansible.
#
# No `flush ruleset`: Docker and Tailscale keep their own tables, and reloading
# this file must not remove them. Declaring the table before deleting it makes
# the delete safe on first load.

table inet lustre
delete table inet lustre

table inet lustre {
    # Docker publishes ports by rewriting the destination in prerouting and
    # forwarding to the container, so those connections never reach `input`
    # below. This chain runs after conntrack and before Docker's rewrite, and
    # applies the same allow-list to every new connection aimed at this
    # machine: a published port is unreachable from the LAN no matter which
    # address compose binds it to.
    #
    # Only new connections are judged. Replies, including a container's
    # replies to tailnet clients, pass untouched.
    chain guard {
        type filter hook prerouting priority mangle; policy accept;

        ct state != new accept
        iifname { "lo", "tailscale0", "docker0" } accept
        # Compose networks are bridges named br-<id>. Wildcards only match
        # outside a set.
        iifname "br-*" accept
        fib daddr type != local accept

        meta l4proto { icmp, ipv6-icmp } accept
        udp dport { 68, 546 } accept
        # Lets tailnet devices on the same LAN connect directly instead of
        # through a relay. Nothing is forwarded from the router.
        udp dport 41641 accept
        # SSH fallback for someone physically on the clinic network when
        # Tailscale is down. Key-only, like every other SSH login.
        ip saddr {{ lan_cidr }} tcp dport 22 accept

        drop
    }

    chain input {
        type filter hook input priority filter; policy drop;

        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop

        # Anything on the tailnet may reach the host. Who is on the tailnet is
        # decided by the clinic account's Tailscale ACLs.
        iifname "tailscale0" accept

        meta l4proto { icmp, ipv6-icmp } accept
        udp dport { 68, 546, 41641 } accept
        ip saddr {{ lan_cidr }} tcp dport 22 accept
    }
}
