# Per-clinic settings for the operator scripts. install.sh copies this to
# ~/.config/lustre/<clinic>.env and fills in AGE_RECIPIENT.

# SSH target: an alias from ~/.ssh/config or the server's Tailscale IP. A node
# shared into your personal tailnet keeps its IP, so this works from either
# account.
LUSTRE_HOST=smilemakers-ts

# Where the production stack's ./backups directory is on the server
# (infra/ansible/tasks/app.yml deploys it to /opt/lustre-prod).
REMOTE_BACKUP_DIR=/opt/lustre-prod/backups

# Defaults to ~/lustre-backups/<clinic>.
LOCAL_BACKUP_DIR=

# The public half of the backup key. It can only encrypt, so it is safe here.
AGE_RECIPIENT=

# Where this machine's failures go: stale backups, failed pulls, failed
# restore checks.
DISCORD_WEBHOOK_URL=

KEEP_DAILY=14
KEEP_MONTHLY=12
STALE_AFTER_HOURS=72
