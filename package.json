{
    "name": "lustre",
    "private": true,
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "dev": "bun --watch packages/server/src/index.ts",
        "start": "bash scripts/dev.sh",
        "server": "bun packages/server/src/index.ts",
        "build:server": "bun build --compile --minify --sourcemap --target=bun-linux-x64-musl-baseline packages/server/src/cli.ts --outfile dist/lustre && rm -rf dist/migrations && cp -r packages/server/src/db/migrations dist/migrations",
        "typecheck": "bun run --filter '*' typecheck",
        "lint": "biome check .",
        "lint:fix": "biome check --write .",
        "format": "biome format --write .",
        "fallow": "fallow",
        "test": "bun test",
        "app": "bun run --cwd packages/app device",
        "app:build": "bun run --cwd packages/app device:build",
        "app:release": "bun run --cwd packages/app device:release",
        "app:stop": "bun run --cwd packages/app device:stop",
        "emu": "bun run --cwd packages/app emu",
        "emu:build": "bun run --cwd packages/app emu:build",
        "emu:start": "bun run --cwd packages/app emu:start",
        "emu:shot": "bun run --cwd packages/app emu:shot",
        "db:generate": "bun run --cwd packages/server db:generate",
        "db:migrate": "bun packages/server/scripts/migrate.ts",
        "db:seed": "bun packages/server/scripts/seed.ts",
        "backup": "bun packages/server/scripts/backup.ts",
        "restore": "bun packages/server/scripts/restore.ts"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.14",
        "@types/bun": "^1.3.14",
        "fallow": "^3.25.0",
        "typescript": "^5.9.3"
    }
}
