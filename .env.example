# Only non-user-editable values live here (SPEC §12).
# Everything configurable by the clinic is a database row edited in-app.

# One database for every worktree — a seed run in one is a seed run for all.
# Production names it `lustre` inside its own container (compose.yaml); the test
# suite has its own, in packages/server/.env.test.
DATABASE_URL=postgres://lustre:lustre@localhost:5432/lustre_dev
POSTGRES_PASSWORD=lustre
PORT=3000
LOG_LEVEL=info

# The clinic machine only (.env.prod / .env.dev, infra/README.md). Leave all of
# these empty on a laptop: the database keeps the single `lustre` superuser and
# the server migrates on boot as whatever DATABASE_URL is.
#
# Read once, when the Postgres volume is created, by
# infra/postgres/init/10-roles.sh: it creates `lustre_owner` (schema, migrations)
# and `lustre_app` (rows only), and marks the database. The seed and the test
# suite refuse a database marked `production`, whatever its hostname.
LUSTRE_ENVIRONMENT=
LUSTRE_OWNER_PASSWORD=
LUSTRE_APP_PASSWORD=
# Production: false, and SERVER_MIGRATION_DATABASE_URL empty, so the running
# server never holds the owner's password. The dev stack sets both.
MIGRATE_ON_BOOT=true
SERVER_MIGRATION_DATABASE_URL=
# Published ports, so the dev stack sits beside production (3001 / 5433).
API_PORT=3000
DB_PORT=5432
# `glitchtip` in production, empty elsewhere.
COMPOSE_PROFILES=

# Bind address for the published server port. In production this is the
# clinic machine's Tailscale IP so nothing listens on the LAN or WAN.
TAILSCALE_IP=0.0.0.0

# This machine's MagicDNS name. `health.check` reports it and the app stores it,
# so the tailnet address is configured here once instead of typed into every
# phone — and moving the server is a change on this line that the handsets pick
# up the next time they connect. Falls back to TAILSCALE_IP above when it is a
# real tailnet address (100.64.0.0/10) and not the 0.0.0.0 dev default; with
# neither set, phones work on the clinic wifi only.
TAILSCALE_HOSTNAME=

# Monitoring (SPEC §17) — the app posting its own failures.
DISCORD_WEBHOOK_URL=

# External liveness check (§17). Nothing can reach the clinic machine from
# outside the tailnet, so the server pings out and the monitor alerts on
# silence. An UptimeRobot heartbeat URL, or any equivalent.
HEARTBEAT_URL=
HEARTBEAT_INTERVAL_SECONDS=300

# GlitchTip (SPEC §17) — client crash reporting, on its own Postgres so §16's
# backups never pick up disposable crash data.
GLITCHTIP_POSTGRES_PASSWORD=glitchtip
# Generate with:
#   bun -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
GLITCHTIP_SECRET_KEY=
# The MagicDNS URL the phones reach GlitchTip on, scheme included. The DSN is
# baked into release builds, so this must resolve anywhere on the tailnet.
# Deliberately empty: a localhost placeholder would satisfy compose's guard and
# ship a DSN no phone can reach, with the failure invisible until you need a
# crash report.
GLITCHTIP_DOMAIN=
# Retention: events older than this are purged nightly by the worker.
GLITCHTIP_MAX_EVENT_LIFE_DAYS=90
# True only long enough to create the first account, then back to False.
GLITCHTIP_OPEN_REGISTRATION=False

# Backups (SPEC §16). This key is NOT stored on the clinic machine — it lives
# with the operator, and off-site upload is refused without it. 32 bytes, hex or
# base64. Generate one with:
#   bun -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
BACKUP_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_STALE_AFTER_HOURS=48

# Off-site destination (§16) — Google Drive, via a service account. All three
# are required together; without them the server still backs up locally.
#
# The folder must live in a SHARED DRIVE, or BACKUP_DRIVE_SUBJECT must name a
# user to impersonate: a service account has no Drive storage of its own, so a
# folder in someone's My Drive fails with storageQuotaExceeded.
BACKUP_DRIVE_FOLDER_ID=
BACKUP_DRIVE_CLIENT_EMAIL=
# The PEM from the service-account JSON. Keep the \n escapes on one line.
BACKUP_DRIVE_PRIVATE_KEY=
BACKUP_DRIVE_SUBJECT=

# Fallback off-site destination. Drive wins when both are configured.
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=lustre
