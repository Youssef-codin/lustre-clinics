{
    "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
    "entry": [
        // Expo loads config plugins by the path string in app.json's "plugins".
        "packages/app/plugins/*.js",
        // Mounted by hand in place of <AppShell /> to review the design system (see App.tsx).
        "packages/app/src/screens/dev/GalleryScreen.tsx"
    ],
    // Props types are exported beside their component by convention; unused ones are not worth blocking on.
    "rules": { "unused-types": "warn" },
    // Metro loads it through require.resolve in metro.config.js, never an import.
    "ignoreDependencies": ["react-native-svg-transformer"],
    "ignoreExports": [
        // The design system's public surface: a component and its props are exported before a screen uses them.
        { "file": "packages/app/src/components/ui/index.ts", "exports": ["*"] },
        // `money.ts` is the renderer-free arithmetic; MoneyValue.tsx wraps it with the layout direction.
        { "file": "packages/app/src/components/domain/MoneyValue.tsx", "exports": ["formatMoney"] },
        { "file": "packages/app/src/components/domain/money.ts", "exports": ["formatMoney"] },
        // The test helper re-exports the app's connection under the same name on purpose.
        { "file": "packages/server/tests/helpers/db.ts", "exports": ["sql"] },
        // Cluster modules forward formatMoney so their screens import money helpers from one place.
        { "file": "packages/app/src/components/domain/index.ts", "exports": ["formatMoney"] },
        { "file": "packages/app/src/screens/day/money.ts", "exports": ["formatMoney"] },
        { "file": "packages/app/src/screens/patients/components/money.ts", "exports": ["formatMoney"] }
    ]
}
